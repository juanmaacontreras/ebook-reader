{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Atril",
  "version": "0.1.0",
  "identifier": "com.atril.reader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Atril",
        "width": 1100,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["Spanish"] } },
    "linux": { "appimage": { "bundleMediaFramework": true } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwM0ZCQzA5M0IzQjg5NkUKUldSdWlUczdDYncva09KMlBtTU8yQ0xhYVFYcG9wbm9HVDZGaXNlU0JHcXBxZURHQ3RvTWlmY2cK",
      "endpoints": ["https://github.com/juanmaacontreras/ebook-reader/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
