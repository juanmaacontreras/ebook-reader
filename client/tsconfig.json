{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "allowJs": false,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    "noEmit": true
  },
  "include": ["src", "tests"]
}
